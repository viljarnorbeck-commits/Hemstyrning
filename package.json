{
  "name": "hemstyrning",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "services/*",
    "In/hemkontroll_3d_komplett"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names HA,APP --prefix-colors yellow,cyan \"npm:dev:simulator\" \"npm:dev:dashboard\"",
    "dev:dashboard": "npm run dev --workspace @hemkontroll/dashboard",
    "dev:simulator": "npm run dev --workspace @hemkontroll/ha-simulator",
    "start:simulator": "npm run start --workspace @hemkontroll/ha-simulator",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "playwright test",
    "prepare:model": "node scripts/prepare-model.mjs",
    "verify:model": "node scripts/verify-model.mjs",
    "build:web": "npm run build --workspace @hemkontroll/dashboard",
    "build:assets": "node scripts/build-client-assets.mjs",
    "build:android": "bash scripts/build-android.sh assembleMobileDebug",
    "build:tv": "bash scripts/build-android.sh assembleTvDebug",
    "build:ios": "bash scripts/build-ios.sh",
    "build:windows": "bash scripts/build-windows.sh",
    "release:publish": "node scripts/publish-local-release.mjs",
    "release:package": "python3 scripts/create-release.py",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "jsqr": "^1.4.0",
    "meshoptimizer": "^1.3.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
