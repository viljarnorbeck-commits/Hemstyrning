# Exempel för lokal utveckling. Lägg aldrig riktiga token i denna exempel-fil.
HA_SIM_HOST=127.0.0.1
HA_SIM_PORT=8123
HA_SIM_TOKEN=hemkontroll-local-dev
HA_SIM_COMMAND_DELAY_MS=250


# Central datakälla. Token får endast anges i ignorerad .env.
HA_MODE=simulator
HA_URL=http://192.168.0.130:8123
HA_TOKEN=
# Behåll false tills REST och WebSocket verifierats. Endast lokal dator tillåts.
HA_ALLOW_CONTROL=false
