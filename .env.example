# Exempel för lokal utveckling. Lägg aldrig riktiga token i denna exempel-fil.
HA_SIM_HOST=127.0.0.1
HA_SIM_PORT=8123
HA_SIM_TOKEN=hemkontroll-local-dev
HA_SIM_COMMAND_DELAY_MS=250


# Central datakälla. Token får endast anges i ignorerad .env.
HA_MODE=simulator
HA_URL=http://192.168.0.130:8123
HA_TOKEN=
# Behåll false tills REST och WebSocket verifierats. Endast lokal dator tillåts.
HA_ALLOW_CONTROL=false

# Direkt Spotify-integrering. Skapa en Spotify-app i developer.spotify.com/dashboard.
# Registrera exakt samma redirect-URI i Spotify. localhost är inte tillåtet.
# Lokal utveckling: öppna Hemstyrning på http://127.0.0.1:5173 (inte localhost).
# Lägg riktiga värden i ignorerad .env, aldrig i Git eller klienten.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/spotify-api/callback
