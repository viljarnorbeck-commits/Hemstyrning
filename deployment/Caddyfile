# Set HEM_HOST to a LAN DNS name with a matching trusted certificate.
# A private CA must be explicitly trusted by each client. Do not disable TLS validation.
{$HEM_HOST} {
 tls internal
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy same-origin
 }
 reverse_proxy 127.0.0.1:8123 {
  header_up X-Hem-Proxy {$HEM_PROXY_SECRET}
 }
}
